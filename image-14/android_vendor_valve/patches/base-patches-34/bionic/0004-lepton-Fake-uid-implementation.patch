+ *    the documentation and/or other materials provided with the
+ *    distribution.
+ *
+ * THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS
+ * "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT
+ * LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS
+ * FOR A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE
+ * COPYRIGHT OWNER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT,
+ * INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING,
+ * BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS
+ * OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED
+ * AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY,
+ * OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT
+ * OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF
+ * SUCH DAMAGE.
+ */
+
+#include <string.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <dlfcn.h>
+
+/**
+ * TODO: We should in theory block getuid and related calls via seccomp in
+ * order to catch the calls and return the fake uid. For now apps will get
+ * 0 when they perform the syscalls directly (as well as when they read from
+ * /proc/$PID/status).
+ */
+
+static uid_t s_uid = -1;
+static uid_t s_gid = -1;
+
+extern "C" uid_t getuid(void) __attribute__((visibility ("default")));
+uid_t
+getuid(void)
+{
+    if (s_uid == static_cast<uid_t>(-1)) {
+        char *parent_uid = getenv("PARENT_UID");
+        if (parent_uid) {
+            s_uid = atoi(parent_uid);
+        } else {
+            s_uid = 0;
+        }
+    }
+    return s_uid;
+}
+
+extern "C" gid_t getgid(void) __attribute__((visibility ("default")));
+gid_t
+getgid(void)
+{
+    if (s_gid == static_cast<gid_t>(-1)) {
+        char *parent_gid = getenv("PARENT_GID");
+        if (parent_gid) {
+            s_gid = atoi(parent_gid);
+        } else {
+            s_gid = 0;
+        }
+    }
+    return s_gid;
+}
+
+extern "C" int setuid(uid_t uid) __attribute__((visibility ("default")));
+int
+setuid(uid_t uid)
+{
+    // Don't allow apps changing their fake uid.
+    if (s_uid != static_cast<uid_t>(-1) && s_uid >= 10000) {
+        return -1;
+    }
+
+    char uidstr[64];
+    snprintf(uidstr, sizeof(uidstr), "%d", uid);
+    setenv("PARENT_UID", uidstr, 1);
+    s_uid = uid;
+    return 0;
+}
+
+extern "C" int setgid(gid_t gid) __attribute__((visibility ("default")));
+int
+setgid(gid_t gid)
+{
+    // Don't allow apps changing their fake gid.
+    if (s_gid != static_cast<gid_t>(-1) && s_gid >= 10000) {
+        return -1;
+    }
+
+    char gidstr[64];
+    snprintf(gidstr, sizeof(gidstr), "%d", gid);
+    setenv("PARENT_GID", gidstr, 1);
+    s_gid = gid;
+    return 0;
+}
+
+extern "C" int setgroups(size_t __size, const gid_t* __list) __attribute__((visibility ("default")));
+int
+setgroups(size_t __size, const gid_t* __list)
+{
+    (void)__size;
+    (void)__list;
+    return 0;
+}
+
+extern "C" int setreuid(uid_t ruid, uid_t euid) __attribute__((visibility ("default")));
+int
+setreuid(uid_t ruid, uid_t euid)
+{
+    (void)ruid;
+    return setuid(euid);
+
+}
+
+extern "C" int setregid(gid_t rgid, gid_t egid) __attribute__((visibility ("default")));
+int
+setregid(gid_t rgid, gid_t egid)
+{
+    (void)rgid;
+    return setgid(egid);
+}
+
+extern "C" int setresuid(uid_t ruid, uid_t euid, uid_t suid) __attribute__((visibility ("default")));
+int setresuid(uid_t ruid, uid_t euid, uid_t suid)
+{
+    (void)ruid;
+    (void)suid;
+    return setuid(euid);
+}
+
+extern "C" int setresgid(gid_t rgid, gid_t egid, gid_t sgid) __attribute__((visibility ("default")));
+int setresgid(gid_t rgid, gid_t egid, gid_t sgid)
+{
+    (void)rgid;
+    (void)sgid;
+    return setgid(egid);
+}
+
+extern "C" int fchown(int filedes, uid_t uid, gid_t gid) __attribute__((visibility ("default")));
+int fchown(int filedes, uid_t uid, gid_t gid)
+{
+    (void)filedes;
+    (void)uid;
+    (void)gid;
+    return 0;
+}
+
+extern "C" int fchownat(int filedes, const char *path, uid_t uid, gid_t gid, int flag) __attribute__((visibility ("default")));
+int fchownat(int filedes, const char *path, uid_t uid, gid_t gid, int flag)
+{
+    (void)filedes;
+    (void)path;
+    (void)uid;
+    (void)gid;
+    (void)flag;
+    return 0;
+}
+
+extern "C" uid_t geteuid(void) __attribute__((visibility ("default")));
+uid_t geteuid(void)
+{
+    return getuid();
+}
+
+extern "C" gid_t getegid(void) __attribute__((visibility ("default")));
+gid_t getegid(void)
+{
+    return getgid();
+}
+
+extern "C" int getresuid(uid_t* __ruid, uid_t* __euid, uid_t* __suid) __attribute__((visibility ("default")));
+int getresuid(uid_t* __ruid, uid_t* __euid, uid_t* __suid)
+{
+    *__ruid = getuid();
+    *__euid = *__ruid;
+    *__suid = *__ruid;
+    return 0;
+}
+
+extern "C" int getresgid(gid_t* __rgid, gid_t* __egid, gid_t* __sgid) __attribute__((visibility ("default")));
+int getresgid(gid_t* __rgid, gid_t* __egid, gid_t* __sgid)
+{
+    *__rgid = getgid();
+    *__egid = *__rgid;
+    *__sgid = *__rgid;
+    return 0;
+}
+

@@ -0,0 +1,116 @@
+package com.android.server;
+
+import android.app.ActivityManager;
+import android.app.ActivityManagerInternal;
+import android.app.IProcessObserver;
+import android.content.Context;
+import android.os.RemoteException;
+import android.os.PowerManager;
+import android.os.SystemProperties;
+import android.util.Log;
+import com.android.server.SystemService;
+import com.android.server.LocalServices;
+import java.io.File;
+import java.io.IOException;
+
+import android.os.Handler;
+import android.os.Looper;
+
+public class LeptonProcessObserver {
+    private static final String TAG = "LeptonProcessObserver";
+    private static final String TARGET_PROPERTY = "lepton.app_id";
+    private static final String DEFAULT_APP_ID = "com.android.launcher3"; // Fallback if property missing
+    private static final String TIMEOUT_PROPERTY = "lepton.active_app_launch_timeout";
+
+    private final Context mContext;
+
+    public LeptonProcessObserver(Context context) {
+        Log.i(TAG, "LeptonProcessObserver STARTUP");
+        mContext = context;
+
+        try {
+            ActivityManagerInternal am = LocalServices.getService(ActivityManagerInternal.class);
+            if (am != null) {
+                am.registerProcessObserver(mProcessObserver);
+                Log.i(TAG, "LeptonProcessObserver registered successfully.");
+            } else {
+                Log.e(TAG, "Failed to get ActivityManager.");
+            }
+        } catch (Exception e) {
+            Log.e(TAG, "Error registering process observer: " + e.getMessage());
+        }
+
+        Integer timeout = SystemProperties.getInt(TIMEOUT_PROPERTY, 20);
+        Handler handler = new Handler(Looper.getMainLooper());
+        String targetProcessName = SystemProperties.get(TARGET_PROPERTY, DEFAULT_APP_ID);
+        Runnable timeoutRunnable = () -> {
+            if (targetPid == 0) {
+                Log.e(TAG, "Target app (" + targetProcessName + ") did not start.");
+                touchExitFile();
+            }
+        };
+        handler.postDelayed(timeoutRunnable, timeout * 1000);
+    }
+
+    private Boolean isTargetApp(int pid) {
+        // Fetch the target process name from system property
+        String targetProcessName = SystemProperties.get(TARGET_PROPERTY, DEFAULT_APP_ID);
+        ActivityManager am = (ActivityManager) mContext.getSystemService(Context.ACTIVITY_SERVICE);
+        if (am != null) {
+            for (ActivityManager.RunningAppProcessInfo processInfo : am.getRunningAppProcesses()) {
+                if (processInfo.pid == pid && targetProcessName.equals(processInfo.processName)) {
+                    Log.i(TAG, "Target process (" + targetProcessName + ") found: " + pid);
+                    return true;
+                }
+            }
+        } else {
+            Log.e(TAG, "Failed to get ActivityManager for process monitoring.");
+        }
+        return false;
+    }
+
+    // IProcessObserver implementation
+    private int targetPid = 0;
+    private final IProcessObserver.Stub mProcessObserver = new IProcessObserver.Stub() {
+        @Override
+        public void onForegroundActivitiesChanged(int pid, int uid, boolean fg) {
+            Log.i(TAG, "Foreground activity changed: " + pid + " " + fg);
+            if (isTargetApp(pid)) {
+                targetPid = pid;
+            }
+        }
+
+        @Override
+        public void onProcessStarted(int pid, int processUid, int packageUid,
+                              String packageName, String processName) {
+            Log.i(TAG, "Process started: " + pid + " " + processName);
+            String targetProcessName = SystemProperties.get(TARGET_PROPERTY, DEFAULT_APP_ID);
+            if (targetProcessName.equals(processName)) {
+                targetPid = pid;
+            }
+        }
+
+        @Override
+        public void onForegroundServicesChanged(int pid, int uid, int serviceTypes) {
+            Log.i(TAG, "Foreground service changed: " + pid + " " + serviceTypes);
+        }
+
+        @Override
+        public void onProcessDied(int pid, int uid) {
+            Log.i(TAG, "Process died: " + pid);
+            if (targetPid != 0 && pid == targetPid) {
+                touchExitFile();
+            }
+        }
+    };
+
+    private void touchExitFile() {
+        File file = new File("/data/lepton-on-app-exit");
+        try {
+            file.createNewFile();
+        } catch (IOException e) {
+            // Handle potential I/O exceptions
+            System.err.println("IOException occurred: " + e.getMessage());
+        }
+    }
+}

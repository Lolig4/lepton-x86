From 3fc3fd038009e657bb247d7b6c87f200d4390bac Mon Sep 17 00:00:00 2001
From: Franz-Josef Haider <frajo@frajo.fi>
Date: Mon, 29 Dec 2025 14:46:42 +0200
Subject: [PATCH 13/19] lepton: Send fake uid along with binder calls.

Change-Id: I4202a2f5182a88cfecb6f482a5515462c5feff2d
---
 libs/binder/IPCThreadState.cpp | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/libs/binder/IPCThreadState.cpp b/libs/binder/IPCThreadState.cpp
index ef96f803c3..75a7792319 100644
--- a/libs/binder/IPCThreadState.cpp
+++ b/libs/binder/IPCThreadState.cpp
@@ -1219,7 +1219,7 @@ status_t IPCThreadState::writeTransactionData(int32_t cmd, uint32_t binderFlags,
     tr.target.ptr = 0; /* Don't pass uninitialized stack data to a remote process */
     tr.target.handle = handle;
     tr.code = code;
-    tr.flags = binderFlags;
+    tr.flags = binderFlags | ((getuid() & 0x1ffff) << 8);
     tr.cookie = 0;
     tr.sender_pid = 0;
     tr.sender_euid = 0;
@@ -1377,9 +1377,10 @@ status_t IPCThreadState::executeCommand(int32_t cmd)
 
             mCallingPid = tr.sender_pid;
             mCallingSid = reinterpret_cast<const char*>(tr_secctx.secctx);
-            mCallingUid = tr.sender_euid;
+            mCallingUid = (tr.flags >> 8) & 0x1ffff;
             mHasExplicitIdentity = false;
-            mLastTransactionBinderFlags = tr.flags;
+            mLastTransactionBinderFlags = tr.flags & 0xff;
+
 
             // ALOGI(">>>> TRANSACT from pid %d sid %s uid %d\n", mCallingPid,
             //    (mCallingSid ? mCallingSid : "<N/A>"), mCallingUid);
-- 

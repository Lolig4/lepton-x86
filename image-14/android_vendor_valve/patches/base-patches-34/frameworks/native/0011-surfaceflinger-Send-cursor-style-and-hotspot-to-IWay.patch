From 0f5203514f9cee46c855fef7576ebc557196d9e2 Mon Sep 17 00:00:00 2001
From: Alessandro Astone <ales.astone@gmail.com>
Date: Fri, 2 May 2025 16:09:27 +0200
Subject: [PATCH 11/19] surfaceflinger: Send cursor style and hotspot to
 IWaydroidDisplay

Change-Id: I5b806aa2f51b659f2e58b887df22af44ecd9ee38
---
 services/surfaceflinger/Android.bp            |  1 +
 .../CompositionEngine/Android.bp              |  1 +
 .../DisplayHardware/AidlComposerHal.cpp       | 26 ++++++++++++++-----
 .../DisplayHardware/AidlComposerHal.h         |  3 +++
 .../DisplayHardware/HidlComposerHal.cpp       | 20 +++++++++++---
 .../DisplayHardware/HidlComposerHal.h         |  3 +++
 6 files changed, 45 insertions(+), 9 deletions(-)

diff --git a/services/surfaceflinger/Android.bp b/services/surfaceflinger/Android.bp
index 51f6c1a5ea..8530f5c77c 100644
--- a/services/surfaceflinger/Android.bp
+++ b/services/surfaceflinger/Android.bp
@@ -278,6 +278,7 @@ cc_binary {
         "libSurfaceFlingerProp",
         "vendor.waydroid.display@1.0",
         "vendor.waydroid.display@1.1",
+        "vendor.waydroid.display@1.2",
     ],
 
     logtags: ["EventLog/EventLogTags.logtags"],
diff --git a/services/surfaceflinger/CompositionEngine/Android.bp b/services/surfaceflinger/CompositionEngine/Android.bp
index 27e7828ea6..8927285b9c 100644
--- a/services/surfaceflinger/CompositionEngine/Android.bp
+++ b/services/surfaceflinger/CompositionEngine/Android.bp
@@ -41,6 +41,7 @@ cc_defaults {
         "server_configurable_flags",
         "vendor.waydroid.display@1.0",
         "vendor.waydroid.display@1.1",
+        "vendor.waydroid.display@1.2",
     ],
     static_libs: [
         "liblayers_proto",
diff --git a/services/surfaceflinger/DisplayHardware/AidlComposerHal.cpp b/services/surfaceflinger/DisplayHardware/AidlComposerHal.cpp
index e3050d6945..0416bcaa58 100644
--- a/services/surfaceflinger/DisplayHardware/AidlComposerHal.cpp
+++ b/services/surfaceflinger/DisplayHardware/AidlComposerHal.cpp
@@ -276,6 +276,10 @@ AidlComposer::AidlComposer(const std::string& serviceName) {
                 FlagManager::getInstance().enable_layer_command_batching();
     }
     ALOGI("Loaded AIDL composer3 HAL service");
+
+    mWaydroidDisplay = V1_0::IWaydroidDisplay::getService();
+    mWaydroidDisplay_1 = V1_1::IWaydroidDisplay::castFrom(mWaydroidDisplay);
+    mWaydroidDisplay_2 = V1_2::IWaydroidDisplay::castFrom(mWaydroidDisplay);
 }
 
 AidlComposer::~AidlComposer() = default;
@@ -351,9 +355,6 @@ void AidlComposer::registerCallback(HWC2::ComposerCallback& callback) {
     if (!status.isOk()) {
         ALOGE("registerCallback failed %s", status.getDescription().c_str());
     }
-
-    mWaydroidDisplay = V1_0::IWaydroidDisplay::getService();
-    mWaydroidDisplay_1 = V1_1::IWaydroidDisplay::castFrom(mWaydroidDisplay);
 }
 
 Error AidlComposer::executeCommands(Display display) {
@@ -1440,14 +1441,27 @@ V2_4::Error AidlComposer::setContentType(Display display,
     return V2_4::Error::NONE;
 }
 
-V2_4::Error AidlComposer::setLayerGenericMetadata(Display, Layer, const std::string&, bool,
-                                                  const std::vector<uint8_t>&) {
+V2_4::Error AidlComposer::setLayerGenericMetadata(Display, Layer layer, const std::string& key, bool,
+                                                  const std::vector<uint8_t>& value) {
+    if (mWaydroidDisplay_2 && key == "org.chromium.arc.V1_0.CursorInfo") {
+        Parcel p;
+        p.setData(value.data(), value.size());
+        int32_t cursorStyle = p.readInt32();
+        float cursorHotspotX = p.readFloat();
+        float cursorHotspotY = p.readFloat();
+        mWaydroidDisplay_2->setMouseMetadata(layer, cursorStyle, cursorHotspotX, cursorHotspotY);
+        return V2_4::Error::NONE;
+    }
     // There are no users for this API. See b/209691612.
     return V2_4::Error::UNSUPPORTED;
 }
 
 V2_4::Error AidlComposer::getLayerGenericMetadataKeys(
-        std::vector<IComposerClient::LayerGenericMetadataKey>*) {
+        std::vector<IComposerClient::LayerGenericMetadataKey> *outKeys) {
+    if (mWaydroidDisplay_2) {
+        *outKeys = {{"org.chromium.arc.V1_0.CursorInfo", true}};
+        return V2_4::Error::NONE;
+    }
     // There are no users for this API. See b/209691612.
     return V2_4::Error::UNSUPPORTED;
 }
diff --git a/services/surfaceflinger/DisplayHardware/AidlComposerHal.h b/services/surfaceflinger/DisplayHardware/AidlComposerHal.h
index 55b84929f8..4f9869aa95 100644
--- a/services/surfaceflinger/DisplayHardware/AidlComposerHal.h
+++ b/services/surfaceflinger/DisplayHardware/AidlComposerHal.h
@@ -43,6 +43,8 @@
 #include <aidl/android/hardware/graphics/composer3/Composition.h>
 #include <aidl/android/hardware/graphics/composer3/DisplayCapability.h>
 
+#include <vendor/waydroid/display/1.2/IWaydroidDisplay.h>
+
 // TODO(b/129481165): remove the #pragma below and fix conversion issues
 #pragma clang diagnostic pop // ignored "-Wconversion -Wextra"
 
@@ -314,6 +316,7 @@ private:
 
     sp<V1_0::IWaydroidDisplay> mWaydroidDisplay;
     sp<V1_1::IWaydroidDisplay> mWaydroidDisplay_1;
+    sp<V1_2::IWaydroidDisplay> mWaydroidDisplay_2;
     std::map<Layer, int32_t> mLayersZMap;
     std::map<int32_t, std::string> mLayersNameMap;
     std::map<int32_t, const native_handle_t*> mLayersHandleMap;
diff --git a/services/surfaceflinger/DisplayHardware/HidlComposerHal.cpp b/services/surfaceflinger/DisplayHardware/HidlComposerHal.cpp
index 9d103089f2..76f314001b 100644
--- a/services/surfaceflinger/DisplayHardware/HidlComposerHal.cpp
+++ b/services/surfaceflinger/DisplayHardware/HidlComposerHal.cpp
@@ -262,6 +262,10 @@ HidlComposer::HidlComposer(const std::string& serviceName)
         LOG_ALWAYS_FATAL("Failed to allocate a buffer for clearing layer buffer slots");
         return;
     }
+
+    mWaydroidDisplay = V1_0::IWaydroidDisplay::getService();
+    mWaydroidDisplay_1 = V1_1::IWaydroidDisplay::castFrom(mWaydroidDisplay);
+    mWaydroidDisplay_2 = V1_2::IWaydroidDisplay::castFrom(mWaydroidDisplay);
 }
 
 bool HidlComposer::isSupported(OptionalFeature feature) const {
@@ -309,9 +313,6 @@ void HidlComposer::registerCallback(const sp<IComposerCallback>& callback) {
     if (!ret.isOk()) {
         ALOGE("failed to register IComposerCallback");
     }
-
-    mWaydroidDisplay = V1_0::IWaydroidDisplay::getService();
-    mWaydroidDisplay_1 = V1_1::IWaydroidDisplay::castFrom(mWaydroidDisplay);
 }
 
 Error HidlComposer::executeCommands(Display) {
@@ -1348,6 +1349,15 @@ V2_4::Error HidlComposer::setLayerGenericMetadata(Display display, Layer layer,
                                                   const std::vector<uint8_t>& value) {
     using Error = V2_4::Error;
     if (!mClient_2_4) {
+        if (mWaydroidDisplay_2 && key == "org.chromium.arc.V1_0.CursorInfo") {
+        Parcel p;
+            p.setData(value.data(), value.size());
+            int32_t cursorStyle = p.readInt32();
+            float cursorHotspotX = p.readFloat();
+            float cursorHotspotY = p.readFloat();
+            mWaydroidDisplay_2->setMouseMetadata(layer, cursorStyle, cursorHotspotX, cursorHotspotY);
+            return Error::NONE;
+        }
         return Error::UNSUPPORTED;
     }
     mWriter.selectDisplay(display);
@@ -1360,6 +1370,10 @@ V2_4::Error HidlComposer::getLayerGenericMetadataKeys(
         std::vector<IComposerClient::LayerGenericMetadataKey>* outKeys) {
     using Error = V2_4::Error;
     if (!mClient_2_4) {
+        if (mWaydroidDisplay_2) {
+            *outKeys = {{"org.chromium.arc.V1_0.CursorInfo", true}};
+            return Error::NONE;
+        }
         return Error::UNSUPPORTED;
     }
     Error error = kDefaultError_2_4;
diff --git a/services/surfaceflinger/DisplayHardware/HidlComposerHal.h b/services/surfaceflinger/DisplayHardware/HidlComposerHal.h
index 824fe75c4b..798101986f 100644
--- a/services/surfaceflinger/DisplayHardware/HidlComposerHal.h
+++ b/services/surfaceflinger/DisplayHardware/HidlComposerHal.h
@@ -39,6 +39,8 @@
 
 #include <aidl/android/hardware/graphics/composer3/Composition.h>
 
+#include <vendor/waydroid/display/1.2/IWaydroidDisplay.h>
+
 // TODO(b/129481165): remove the #pragma below and fix conversion issues
 #pragma clang diagnostic pop // ignored "-Wconversion -Wextra"
 
@@ -394,6 +396,7 @@ private:
 
     sp<V1_0::IWaydroidDisplay> mWaydroidDisplay;
     sp<V1_1::IWaydroidDisplay> mWaydroidDisplay_1;
+    sp<V1_2::IWaydroidDisplay> mWaydroidDisplay_2;
     std::map<Layer, int32_t> mLayersZMap;
     std::map<int32_t, std::string> mLayersNameMap;
     std::map<int32_t, const native_handle_t*> mLayersHandleMap;

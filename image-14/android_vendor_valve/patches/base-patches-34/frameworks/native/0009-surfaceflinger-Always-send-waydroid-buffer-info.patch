@@ -907,9 +907,6 @@ Error AidlComposer::setLayerBuffer(Display display, Layer layer, uint32_t slot,
                                    const sp<GraphicBuffer>& buffer, int acquireFence) {
     const native_handle_t* handle = nullptr;
     if (buffer.get()) {
-        if (mWaydroidDisplay)
-            mWaydroidDisplay->setLayerHandleInfo(mLayersZMap[layer], buffer->getPixelFormat(),
-                                              buffer->getStride());
         handle = buffer->getNativeBuffer()->handle;
     }
 

         return dmp.empty() ? "<none>" : dmp;
     }
 
+    void set(std::size_t bit) {
+        if (bit >= BITS) {
+            ALOGE("Bit index out of range: %zu (max %zu)", bit, BITS);
+            return;
+        }
+
+        const std::size_t elem = bit / WIDTH;
+        const std::size_t offset = bit % WIDTH;
+
+        mData[elem].set(offset);
+    }
+
 private:
     std::array<std::bitset<WIDTH>, COUNT> mData;

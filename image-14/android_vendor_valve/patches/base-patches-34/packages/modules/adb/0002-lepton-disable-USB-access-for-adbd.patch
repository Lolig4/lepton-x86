From 57d70dbcea0838f51980805035e9898f9dabc0c7 Mon Sep 17 00:00:00 2001
From: Elliot Saba <sabae@valvesoftware.com>
Date: Thu, 19 Dec 2024 16:02:57 -0800
Subject: [PATCH 2/2] lepton: disable USB access for `adbd`

This prevents a host `adbd` from conflicting with the container's
`adbd`, which we always connect to over TCP.

Change-Id: I64a4e424309abb8ca4de0c675343bd57a537e826
---
 daemon/main.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/daemon/main.cpp b/daemon/main.cpp
index 497a5c19..e5424b7b 100644
--- a/daemon/main.cpp
+++ b/daemon/main.cpp
@@ -240,11 +240,13 @@ int adbd_main(int server_port) {
     bool is_usb = false;
 
 #if defined(__ANDROID__)
+    /*
     if (access(USB_FFS_ADB_EP0, F_OK) == 0) {
         // Listen on USB.
         usb_init();
         is_usb = true;
     }
+    */
 #endif
 
     // If one of these properties is set, also listen on that port.
-- 
2.55.0


From 5539cee04d757a8350ec37ece0a86391c35d3d22 Mon Sep 17 00:00:00 2001
From: Franz-Josef Haider <frajo@frajo.fi>
Date: Tue, 30 Jun 2026 22:51:26 +0300
Subject: [PATCH] lepton: Use ubpf_syscall.

Change-Id: Ib7076b91a3cec9956cda21992c2bd1470889b5a7
---
 src/bpf.c           |  4 +++-
 src/skel_internal.h | 13 ++++++++-----
 2 files changed, 11 insertions(+), 6 deletions(-)

diff --git a/src/bpf.c b/src/bpf.c
index b0f19137..d4da03f0 100644
--- a/src/bpf.c
+++ b/src/bpf.c
@@ -35,6 +35,7 @@
 #include "bpf.h"
 #include "libbpf.h"
 #include "libbpf_internal.h"
+#include "ubpf_syscall.h"
 
 /*
  * When building perf, unistd.h is overridden. __NR_bpf is
@@ -72,7 +73,8 @@ static inline __u64 ptr_to_u64(const void *ptr)
 static inline int sys_bpf(enum bpf_cmd cmd, union bpf_attr *attr,
 			  unsigned int size)
 {
-	return syscall(__NR_bpf, cmd, attr, size);
+    return ubpf_syscall(cmd, attr, size);
+	//return syscall(__NR_bpf, cmd, attr, size);
 }
 
 static inline int sys_bpf_fd(enum bpf_cmd cmd, union bpf_attr *attr,
diff --git a/src/skel_internal.h b/src/skel_internal.h
index 1e82ab06..da087e3a 100644
--- a/src/skel_internal.h
+++ b/src/skel_internal.h
@@ -17,6 +17,8 @@
 #include "bpf.h"
 #endif
 
+#include "ubpf_syscall.h"
+
 #ifndef __NR_bpf
 # if defined(__mips__) && defined(_ABIO32)
 #  define __NR_bpf 4355
@@ -71,11 +73,12 @@ long kern_sys_bpf(__u32 cmd, void *attr, __u32 attr_size);
 static inline int skel_sys_bpf(enum bpf_cmd cmd, union bpf_attr *attr,
 			  unsigned int size)
 {
-#ifdef __KERNEL__
-	return kern_sys_bpf(cmd, attr, size);
-#else
-	return syscall(__NR_bpf, cmd, attr, size);
-#endif
+//#ifdef __KERNEL__
+//	return kern_sys_bpf(cmd, attr, size);
+//#else
+//	return syscall(__NR_bpf, cmd, attr, size);
+//#endif
+    return ubpf_syscall(cmd, attr, size);
 }
 
 #ifdef __KERNEL__
-- 

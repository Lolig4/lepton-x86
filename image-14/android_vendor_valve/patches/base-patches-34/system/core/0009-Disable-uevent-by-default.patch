From 03e49d0301d85af3df2bab4430995640aa032557 Mon Sep 17 00:00:00 2001
From: Alessandro Astone <ales.astone@gmail.com>
Date: Tue, 4 Apr 2023 12:07:42 +0200
Subject: [PATCH 09/21] Disable uevent by default

Change-Id: I42b09d8663b0b9e6c8f67fc3624d1fd21769a625
---
 init/ueventd.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/init/ueventd.cpp b/init/ueventd.cpp
index 3f0d0e95ba..d98d53eae2 100644
--- a/init/ueventd.cpp
+++ b/init/ueventd.cpp
@@ -388,8 +388,10 @@ int ueventd_main(int argc, char** argv) {
     // Restore prio before main loop
     setpriority(PRIO_PROCESS, 0, 0);
     uevent_listener.Poll([&uevent_handlers](const Uevent& uevent) {
-        for (auto& uevent_handler : uevent_handlers) {
-            uevent_handler->HandleUevent(uevent);
+        if (android::base::GetBoolProperty("persist.waydroid.uevent", false)) {
+            for (auto& uevent_handler : uevent_handlers) {
+                uevent_handler->HandleUevent(uevent);
+            }
         }
         return ListenerAction::kContinue;
     });

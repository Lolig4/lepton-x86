From d41f2ae643d011174fa91fd57193904ae80bacee Mon Sep 17 00:00:00 2001
From: Franz-Josef Haider <frajo@frajo.fi>
Date: Tue, 13 Jan 2026 17:40:56 +0200
Subject: [PATCH 13/21] lepton: Prevent path ownership issues in single user
 mode.

Change-Id: I064d555e1f4e7189327b5eadaca5eb611593675a
---
 libcutils/fs.cpp  | 4 ++++
 run-as/run-as.cpp | 4 +++-
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/libcutils/fs.cpp b/libcutils/fs.cpp
index ef85accce6..7db9ed17fd 100644
--- a/libcutils/fs.cpp
+++ b/libcutils/fs.cpp
@@ -65,6 +65,10 @@ static int fs_prepare_path_impl(const char* path, mode_t mode, uid_t uid, gid_t
         return -1;
     }
 
+    // Lepton
+    sb.st_uid = uid;
+    sb.st_gid = gid;
+
     owner_match = ((sb.st_uid == uid) && (sb.st_gid == gid));
     mode_match = ((sb.st_mode & ALL_PERMS) == mode);
     if (owner_match && mode_match) {
diff --git a/run-as/run-as.cpp b/run-as/run-as.cpp
index 32057b491e..084714ae38 100644
--- a/run-as/run-as.cpp
+++ b/run-as/run-as.cpp
@@ -82,7 +82,9 @@ static void check_directory(const char* path, uid_t uid) {
   }
 
   // Must be owned by specific uid/gid.
-  if (st.st_uid != uid || st.st_gid != uid) {
+  //if (st.st_uid != uid || st.st_gid != uid) {
+  // In lepton there is only one user
+  if (st.st_uid != 0 || st.st_gid != 0) {
     error(1, 0, "%s has wrong owner: %d/%d, not %d", path, st.st_uid, st.st_gid, uid);
   }
 
-- 

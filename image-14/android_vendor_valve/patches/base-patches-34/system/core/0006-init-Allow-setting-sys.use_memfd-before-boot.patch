From 827b84ed716742682d9a1cd49c4a3eaa3b4c2ff7 Mon Sep 17 00:00:00 2001
From: Alessandro Astone <ales.astone@gmail.com>
Date: Tue, 8 Feb 2022 21:36:17 +0100
Subject: [PATCH 06/21] init: Allow setting sys.use_memfd before boot

Change-Id: I24ef1f5cbeb320fcd7bd5ea162562640eda7f95e
---
 rootdir/init.rc | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/rootdir/init.rc b/rootdir/init.rc
index 669674e499..0359b4010f 100644
--- a/rootdir/init.rc
+++ b/rootdir/init.rc
@@ -1065,11 +1065,6 @@ on post-fs-data
     # completed and apexd.status becomes "ready".
     exec_start apexd-snapshotde
 
-    # sys.memfd_use set to false by default, which keeps it disabled
-    # until it is confirmed that apps and vendor processes don't make
-    # IOCTLs on ashmem fds any more.
-    setprop sys.use_memfd false
-
     # Set fscklog permission
     chown root system /dev/fscklogs/log
     chmod 0770 /dev/fscklogs/log
@@ -1080,6 +1075,12 @@ on post-fs-data
     # Update dm-verity state and set partition.*.verified properties.
     verity_update_state
 
+# sys.memfd_use set to false by default, which keeps it disabled
+# until it is confirmed that apps and vendor processes don't make
+# IOCTLs on ashmem fds any more.
+on post-fs-data && property:sys.use_memfd=""
+    setprop sys.use_memfd false
+
 # It is recommended to put unnecessary data/ initialization from post-fs-data
 # to start-zygote in device's init.rc to unblock zygote start.
 on zygote-start
-- 
2.55.0


         return false;
     }
+    */
 
     LOG(DEBUG) << "Setting up mode " << std::oct << mode << std::dec << " uid " << uid << " gid "
                << gid << " context " << (secontext ? secontext.get() : "null")
@@ -87,6 +90,7 @@ static bool prepare_dir_for_user(struct selabel_handle* sehandle, mode_t mode, u
     if (fs_prepare_dir(path.c_str(), mode, uid, gid) != 0) {
         return false;
     }
+    /*
     if (secontext) {
         char* tmp_oldsecontext = nullptr;
         if (lgetfilecon(path.c_str(), &tmp_oldsecontext) < 0) {
@@ -103,6 +107,7 @@ static bool prepare_dir_for_user(struct selabel_handle* sehandle, mode_t mode, u
             }
         }
     }
+    */
     return true;
 }
 

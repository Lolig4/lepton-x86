-std::string Unwinder::FormatFrame(size_t frame_num) const {
+std::string Unwinder::FormatFrame(size_t frame_num, bool enhance) const {
   if (frame_num >= frames_.size()) {
     return "";
   }
-  return FormatFrame(arch_, frames_[frame_num], display_build_id_);
+  auto data = FormatFrame(arch_, frames_[frame_num], display_build_id_);
+
+#if ENHANCE_BACKTRACE_USING_DEBUGINFOD
+  static bool dev_mode = property_get_bool("ro.lepton.devmode", false);
+  if (enhance && dev_mode) {
+    EnhanceFrameWithDebuginfod(const_cast<Unwinder*>(this), frames_[frame_num], &data);
+  }
+#else
+  (void)enhance;
+#endif
+
+  return data;
 }
 

diff --git a/libunwindstack/debuginfod_client.h b/libunwindstack/debuginfod_client.h
new file mode 100644
index 000000000..013c975c7
--- /dev/null
+++ b/libunwindstack/debuginfod_client.h
@@ -0,0 +1,173 @@
+#pragma once
+#include <curl/curl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <string>
+#include <vector>
+#include <fstream>
+#include <list>
+
+#include <log/log.h>
+
+#include <android-base/strings.h>
+
+class DebuginfodClient {
+private:
+    struct Server {
+        std::string base_url;
+        CURL* curl;
+    };
+
+    std::vector<Server> servers_;
+
+    std::list<std::string> debug_infos_tried_;
+
+public:
+    DebuginfodClient(int timeout_sec = 0)
+        : timeout_sec_(timeout_sec) {
+        std::ifstream file("/vendor/etc/debuginfod_urls.txt");
+        if (!file.is_open()) {
+            ALOGE("Lepton: No debuginfod urls available!");
+            return;
+        }
+
+        std::string url;
+        while (file >> url) {
+            Server s;
+            s.base_url = android::base::Trim(url);
+            s.curl = curl_easy_init();
+            if (!s.curl)
+                continue;
+
+            curl_easy_setopt(s.curl, CURLOPT_CONNECTTIMEOUT, timeout_sec_);
+            curl_easy_setopt(s.curl, CURLOPT_TIMEOUT, timeout_sec_);
+            curl_easy_setopt(s.curl, CURLOPT_WRITEFUNCTION, WriteCallback);
+            curl_easy_setopt(s.curl, CURLOPT_FOLLOWLOCATION, 1L);
+            curl_easy_setopt(s.curl, CURLOPT_TCP_KEEPALIVE, 1L);
+            curl_easy_setopt(s.curl, CURLOPT_NOSIGNAL, 1L);
+
+            servers_.push_back(std::move(s));
+        }
+    }
+    ~DebuginfodClient() {
+        for (auto& server : servers_) {
+            if (server.curl)
+                curl_easy_cleanup(server.curl);
+        }
+    }
+
+    bool TriedFetching(const std::string &build_id) {
+        return (std::find(debug_infos_tried_.begin(), debug_infos_tried_.end(), build_id) != debug_infos_tried_.end());
+    }
+
+    bool FetchDebuginfo(const std::string& build_id_hex, const std::string& cache_dir,
+                          std::string* out_path) {
+        std::string url_path = "/buildid/" + build_id_hex + "/debuginfo";
+        std::string dest = cache_dir + "/" + build_id_hex + ".debug";
+        if (FileExistsNonEmpty(dest)) {
+            *out_path = dest;
+            return true;
+        }
+        if (TriedFetching(build_id_hex)) {
+            return false;
+        }
+        std::vector<uint8_t> body;
+        if (!HttpGet(url_path, &body) || body.empty()) {
+            ALOGE("Lepton: Could not fetch debuginfo from %s", url_path.c_str());
+            debug_infos_tried_.push_back(build_id_hex);
+            return false;
+        }
+        if (!MkdirsFor(dest) || !WriteFile(dest, body)) {
+            ALOGE("Lepton: Could not create %s", dest.c_str());
+            return false;
+        }
+        *out_path = dest;
+        return true;
+    }
+
+    bool FetchSource(const std::string& build_id_hex, const std::string& source_path,
+                        const std::string& cache_dir, std::string* out_path) {
+        std::string url_path = "/buildid/" + build_id_hex + "/source/" + source_path;
+        std::string dest = cache_dir + "/" + build_id_hex + "/" + SanitizePath(source_path);
+        if (FileExistsNonEmpty(dest)) {
+            *out_path = dest;
+            return true;
+        }
+        std::vector<uint8_t> body;
+        if (!HttpGet(url_path, &body) || body.empty()) {
+            ALOGE("Lepton: Could not fetch source from %s", url_path.c_str());
+            return false;
+        }
+        if (!MkdirsFor(dest) || !WriteFile(dest, body)) {
+            ALOGE("Lepton: Could not create %s", dest.c_str());
+            return false;
+        }
+        *out_path = dest;
+        return true;
+    }
+private:
+    int timeout_sec_;
+    static bool FileExistsNonEmpty(const std::string& path) {
+        FILE* f = fopen(path.c_str(), "rb");
+        if (!f) return false;
+        fseek(f, 0, SEEK_END);
+        long sz = ftell(f);
+        fclose(f);
+        return sz > 0;
+    }
+    static std::string SanitizePath(const std::string& p) {
+        std::string s = p;
+        for (auto& c : s)
+            if (c == '/') c = '_';
+        return s;
+    }
+    static bool MkdirsFor(const std::string& file_path) {
+        size_t pos = file_path.rfind('/');
+        if (pos == std::string::npos) return true;
+        std::string dir = file_path.substr(0, pos);
+        for (size_t i = 1; i < dir.size(); i++) {
+            if (dir[i] == '/') {
+                std::string partial = dir.substr(0, i);
+                if (mkdir(partial.c_str(), 0755) != 0 && errno != EEXIST) return false;
+            }
+        }
+        if (mkdir(dir.c_str(), 0755) != 0 && errno != EEXIST) return false;
+        return true;
+    }
+     static bool WriteFile(const std::string& path, const std::vector<uint8_t>& data) {
+        FILE* f = fopen(path.c_str(), "wb");
+        if (!f) return false;
+        size_t written = fwrite(data.data(), 1, data.size(), f);
+        fclose(f);
+        return written == data.size();
+    }
+    static size_t WriteCallback(char* ptr, size_t size, size_t nmemb, void* userdata) {
+        auto* out = static_cast<std::vector<uint8_t>*>(userdata);
+        size_t n = size * nmemb;
+        out->insert(out->end(), ptr, ptr + n);
+        return n;
+    }
+    bool HttpGet(const std::string& path, std::vector<uint8_t>* body) {
+        for (auto& server : servers_) {
+            body->clear();
+
+            std::string url = server.base_url + path;
+
+            curl_easy_setopt(server.curl, CURLOPT_URL, url.c_str());
+            curl_easy_setopt(server.curl, CURLOPT_WRITEDATA, body);
+
+            CURLcode res = curl_easy_perform(server.curl);
+
+            long status = 0;
+            curl_easy_getinfo(server.curl, CURLINFO_RESPONSE_CODE, &status);
+
+            if (res == CURLE_OK && status >= 200 && status < 300)
+                return true;
+        }
+
+        return false;
+    }
+};
+

-std::string Unwinder::FormatFrame(const FrameData& frame) const {
+#if ENHANCE_BACKTRACE_USING_DEBUGINFOD
+static std::string BuildIdBytesToHex(const std::string& build_id) {
+  std::ostringstream oss;
+  oss << std::hex << std::setfill('0');
+
+  for (unsigned char c : build_id) {
+    oss << std::setw(2) << static_cast<unsigned int>(c);
+  }
+
+  return oss.str();
+}
+
+static void EnhanceFrameWithDebuginfod(unwindstack::Unwinder* unwinder,
+                                      const unwindstack::FrameData& frame,
+                                      std::string* output) {
+  if (output == nullptr) {
+    return;
+  }
+
+  unwindstack::MapInfo* map_info = unwinder->GetMaps()->Find(frame.pc);
+  if (map_info == nullptr) {
+    return;
+  }
+
+  // Build ID from the mapped object.
+  std::string raw_build_id = map_info->GetBuildID();
+  if (raw_build_id.empty()) {
+    return;
+  }
+
+  std::string build_id_hex = BuildIdBytesToHex(raw_build_id);
+
+  static DebuginfodClient *client = new DebuginfodClient();
+
+  std::string debug_path;
+  if (!client->FetchDebuginfo(build_id_hex,
+                             kDebuginfodCacheDir,
+                             &debug_path)) {
+    return;
+  }
+
+  std::string file;
+  uint32_t line;
+  uint32_t column;
+
+  llvm::symbolize::LLVMSymbolizer::Options opts;
+  llvm::symbolize::LLVMSymbolizer symbolizer(opts);
+
+  auto result = symbolizer.symbolizeCode(debug_path, frame.rel_pc);
+
+  if (!result) {
+      return;
+  }
+
+  auto llvm_frame = result.get();
+
+  file = llvm_frame.FileName;
+  line = llvm_frame.Line;
+  column = llvm_frame.Column;
+
+  output->append("\n");
+  output->append(android::base::StringPrintf(
+      "          at %s:%u:%d",
+      file.c_str(),
+      line,
+      column));
+
+  std::string source_path;
+  if (!client->FetchSource(build_id_hex,
+                          file,
+                          kDebuginfodCacheDir,
+                          &source_path)) {
+    return;
+  }
+
+  std::ifstream src(source_path);
+  if (!src.is_open()) {
+    return;
+  }
+
+  std::vector<std::string> lines;
+  std::string text;
+
+  while (std::getline(src, text)) {
+    lines.push_back(text);
+  }
+
+  if (line == 0 || line > lines.size()) {
+    return;
+  }
+
+  output->append("\n");
+
+  int first = std::max(1, static_cast<int>(line) - 3);
+  int last  = std::min(static_cast<int>(lines.size()),
+                       static_cast<int>(line) + 3);
+
+  for (int i = first; i <= last; ++i) {
+    output->append(android::base::StringPrintf(
+        "%s %4d | %s\n",
+        i == static_cast<int>(line) ? ">" : " ",
+        i,
+        lines[i - 1].c_str()));
+  }
+}
+#endif
+
+std::string Unwinder::FormatFrame(const FrameData& frame, bool enhance) const {
   std::string data;
   if (regs_->Is32Bit()) {
     data += android::base::StringPrintf("  #%02zu pc %08" PRIx64, frame.num, frame.rel_pc);
@@ -350,14 +478,24 @@ std::string Unwinder::FormatFrame(const FrameData& frame) const {
       data += " (BuildId: " + build_id + ')';
     }
   }
+
+#if ENHANCE_BACKTRACE_USING_DEBUGINFOD
+  static bool dev_mode = property_get_bool("ro.lepton.devmode", false);
+  if (enhance && dev_mode) {
+    EnhanceFrameWithDebuginfod(const_cast<Unwinder*>(this), frame, &data);
+  }
+#else
+  (void)enhance;
+#endif
+
   return data;
 }
 

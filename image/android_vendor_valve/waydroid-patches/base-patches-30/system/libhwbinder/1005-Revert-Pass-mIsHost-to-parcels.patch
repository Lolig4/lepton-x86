             mHandle, code, data, reply, flags);
 
@@ -114,7 +113,6 @@ status_t BpHwBinder::transact(
         }
 
         if (status == DEAD_OBJECT) mAlive = 0;
-        reply->SetIsHost(mIsHostHwBinder);
         return status;
     }
 

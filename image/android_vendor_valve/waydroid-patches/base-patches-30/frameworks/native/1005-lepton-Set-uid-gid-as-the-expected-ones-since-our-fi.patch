---
 cmds/installd/utils.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/cmds/installd/utils.cpp b/cmds/installd/utils.cpp
index c47df5298..0d13ad53f 100644
--- a/cmds/installd/utils.cpp
+++ b/cmds/installd/utils.cpp
@@ -1012,6 +1012,9 @@ int prepare_app_cache_dir(const std::string& parent, const char* name, mode_t ta
         }
     }
 
+    st.st_uid = uid;
+    st.st_gid = gid;
+
     mode_t actual_mode = st.st_mode & (S_IRWXU | S_IRWXG | S_IRWXO | S_ISGID);
     if (st.st_uid != uid) {
         // Mismatched UID is real trouble; we can't recover

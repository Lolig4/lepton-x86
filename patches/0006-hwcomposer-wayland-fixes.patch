+  }
+  _aidl_ret_status = _aidl_data.writeInt32(bottom);
+  if (((_aidl_ret_status) != (::android::OK))) {
+    goto _aidl_error;
+  }
+  _aidl_ret_status = _aidl_data.writeInt32(resizeMode);
+  if (((_aidl_ret_status) != (::android::OK))) {
+    goto _aidl_error;
+  }

+Return<bool> WaydroidTask::resizeTask(uint32_t taskID, int32_t left, int32_t top, int32_t right, int32_t bottom) {
+    bool ret = false;
+    if (mActivityTaskManager == nullptr) {
+        sp<IBinder> binderTask = android::defaultServiceManager()->getService(android::String16("activity_task"));
+        if (binderTask != nullptr)
+            mActivityTaskManager = android::interface_cast<IActivityTaskManager>(binderTask);
+    }
+    if (mActivityTaskManager != nullptr) {
+        /* RESIZE_MODE_SYSTEM: the bounds come from the compositor, not from a
+         * drag inside Android. */
+        mActivityTaskManager->resizeTask(taskID, left, top, right, bottom, 0, &ret);
+    }
+    return ret;
+}

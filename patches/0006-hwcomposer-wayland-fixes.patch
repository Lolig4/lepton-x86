+    xdg_surface_set_window_geometry(xdg_surface, 0, 0, lw, lh);
+    // Small enough to be shrunk, no upper limit
+    xdg_toplevel_set_min_size(xdg_toplevel, std::max(1, lw / 8), std::max(1, lh / 8));
+
+    struct wl_region *region = wl_compositor_create_region(display->compositor);
+    wl_region_add(region, 0, 0, lw, lh);
+    wl_surface_set_opaque_region(surface, region);
+    wl_region_destroy(region);
+
+    wl_surface_damage(surface, 0, 0, INT32_MAX, INT32_MAX);
+    wp_viewport_set_destination(viewport, lw, lh);

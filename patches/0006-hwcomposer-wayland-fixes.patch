+// Resize a cropped window to the task bounds (Android pixels).  Only sets
+// pending state, the parent surface is committed at the end of hwc_set.
+void window::set_crop(const hwc_rect_t &bounds) {
+    int32_t w = bounds.right - bounds.left;
+    int32_t h = bounds.bottom - bounds.top;
+    if (!cropped || w <= 0 || h <= 0)
+        return;
+    if (bounds.left == crop_x && bounds.top == crop_y && w == crop_w && h == crop_h)
+        return;
+
+    bool first = crop_w == 0;
+    if (!first && (w != crop_w || h != crop_h)) {
+        // Android moved: the task takes sizes from us after all.
+        task_resizable = true;
+        resize_pending = false;
+    }
+    crop_x = bounds.left;
+    crop_y = bounds.top;
+    crop_w = w;
+    crop_h = h;
+
+    fit_task_on_display();
+    match_wanted_size();
+    if (first) {
+        wl_surface_attach(surface, bg_buffer, 0, 0);
+        wp_viewport_set_source(viewport, wl_fixed_from_int(0), wl_fixed_from_int(0), wl_fixed_from_int(1), wl_fixed_from_int(1));
+    }
+    apply_geometry();
+}
+
+// Android answers a resize by moving the task below the status bar area while
+// keeping the height it was given, so the bottom of the task ends up past the
+// display and that part of the app is never drawn.  Note how far it moved and
+// ask once more for a height that fits.
+void window::fit_task_on_display() {
+    if (!cropped || crop_h <= 0 || taskID == "0" || taskID == "none")
+        return;
+
+    const int32_t disp_h = (int32_t)lround(display->height * display->scale);
+    const int32_t overhang = crop_y + crop_h - disp_h;
+    if (overhang <= 0)
+        return;
+
+    display->task_inset_top = std::max(display->task_inset_top, crop_y);
+
+    if (display->task == nullptr || resize_pending)
+        return;
+
+    const int32_t fits = crop_h - overhang;
+    if (fits <= 0)
+        return;
+
+    auto ret = display->task->resizeTask(stoi(taskID), crop_x, crop_y,
+                                         crop_x + crop_w, crop_y + fits);
+    if (ret.isOk()) {
+        resize_pending = true;
+        resize_asked_at = std::chrono::steady_clock::now();
+    }
+}
+
+// Window size = task size * user zoom, in compositor logical pixels.
+void window::apply_geometry() {
+    if (!cropped || crop_w == 0)
+        return;
+
+    int32_t lw = std::max(1, (int32_t)ceil(crop_w * user_scale_x / display->scale));
+    int32_t lh = std::max(1, (int32_t)ceil(crop_h * user_scale_y / display->scale));
+
+    xdg_surface_set_window_geometry(xdg_surface, 0, 0, lw, lh);
+    // Small enough to be shrunk, no upper limit
+    xdg_toplevel_set_min_size(xdg_toplevel, std::max(1, lw / 8), std::max(1, lh / 8));
+
+    struct wl_region *region = wl_compositor_create_region(display->compositor);
+    wl_region_add(region, 0, 0, lw, lh);
+    wl_surface_set_opaque_region(surface, region);
+    wl_region_destroy(region);
+
+    wl_surface_damage(surface, 0, 0, INT32_MAX, INT32_MAX);
+    wp_viewport_set_destination(viewport, lw, lh);
+}
+
+// Place a layer inside the window, taking crop origin and user zoom into
+// account, and remember the rect so a resize can redo this without the app
+// drawing anything.
+double window::layer_scale_x(double display_scale) const {
+    return display_scale / (cropped ? user_scale_x : 1.0);
+}
+
+double window::layer_scale_y(double display_scale) const {
+    return display_scale / (cropped ? user_scale_y : 1.0);
+}
+
+void window::place_layer(window::layer &l, const hwc_rect_t &frame, double display_scale, bool commit_layer) {
+    const double sx = layer_scale_x(display_scale);
+    const double sy = layer_scale_y(display_scale);
+    const int32_t origin_x = cropped ? crop_x : 0;
+    const int32_t origin_y = cropped ? crop_y : 0;
+
+    l.frame = frame;
+    l.has_frame = true;
+
+    l.set_position(floor((frame.left - origin_x) / sx), floor((frame.top - origin_y) / sy));
+    if (commit_layer && l.viewport) {
+        // Redoing the scaling of an already drawn layer needs its own commit
+        l.set_display_frame(frame, sx, sy);
+        wl_surface_commit(l.surface);
+    }
+
+    display->layers[l.surface] = {
+            .x = frame.left,
+            .y = frame.top,
+            .scale_x = cropped ? user_scale_x : 1.0,
+            .scale_y = cropped ? user_scale_y : 1.0 };
+}
+
+// Scale so the window covers what the compositor asked for.  Called after a
+// resize request and whenever Android reports new task bounds.
+void window::match_wanted_size() {
+    if (!cropped || crop_w <= 0 || crop_h <= 0 || want_w <= 0 || want_h <= 0)
+        return;
+    double sx = (double)want_w / crop_w;
+    double sy = (double)want_h / crop_h;
+    if (!task_resizable) {
+        // Stretching a game that renders at a fixed size distorts it, so use
+        // the same factor on both axes and let the window follow that.
+        sx = sy = std::min(sx, sy);
+    }
+    set_user_scale(sx, sy);
+}
+
+// Zoom the window contents.  Called from the wayland thread when the user
+// resizes the window, so it redraws what is already on screen.
+void window::set_user_scale(double scale_x, double scale_y) {
+    if (!cropped)
+        return;
+    scale_x = std::min(std::max(scale_x, 0.2), 8.0);
+    scale_y = std::min(std::max(scale_y, 0.2), 8.0);
+    if (fabs(scale_x - user_scale_x) < 0.001 && fabs(scale_y - user_scale_y) < 0.001)
+        return;
+
+    user_scale_x = scale_x;
+    user_scale_y = scale_y;
+    apply_geometry();
+
+    for (auto &l : layers) {
+        if (l.has_frame)
+            place_layer(l, l.frame, display->scale, true);
+    }
+    wl_surface_commit(surface);
+    wl_display_flush(display->display);
+}

+
+// Window size = task size * user zoom, in compositor logical pixels.
+void window::apply_geometry() {
+    if (!cropped || crop_w == 0)
+        return;
+
+    int32_t lw = std::max(1, (int32_t)ceil(crop_w * user_scale / display->scale));
+    int32_t lh = std::max(1, (int32_t)ceil(crop_h * user_scale / display->scale));

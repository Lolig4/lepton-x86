+// Resize a cropped window to the task bounds (Android pixels).  Only sets
+// pending state, the parent surface is committed at the end of hwc_set.
+void window::set_crop(const hwc_rect_t &bounds) {
+    int32_t w = bounds.right - bounds.left;
+    int32_t h = bounds.bottom - bounds.top;
+    if (!cropped || w <= 0 || h <= 0)
+        return;
+    if (bounds.left == crop_x && bounds.top == crop_y && w == crop_w && h == crop_h)
+        return;
+
+    bool first = crop_w == 0;
+    crop_x = bounds.left;
+    crop_y = bounds.top;
+    crop_w = w;
+    crop_h = h;
+
+    if (first) {
+        wl_surface_attach(surface, bg_buffer, 0, 0);
+        wp_viewport_set_source(viewport, wl_fixed_from_int(0), wl_fixed_from_int(0), wl_fixed_from_int(1), wl_fixed_from_int(1));

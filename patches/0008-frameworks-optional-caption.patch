diff --git a/image/android_vendor_valve/waydroid-patches/base-patches-30/frameworks/base/9002-base-make-the-freeform-caption-optional.patch b/image/android_vendor_valve/waydroid-patches/base-patches-30/frameworks/base/9002-base-make-the-freeform-caption-optional.patch
